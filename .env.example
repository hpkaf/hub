# 复制为 .env 后按需填写；run_daily.sh 会自动加载（不要提交 .env 到仓库）
# 站点对外地址：用于 sitemap.xml / llms.txt / api/events.json 里的绝对链接
SITE_URL=https://your-domain.example

# 投稿邮箱：设置后 submit 页「生成投稿」直接打开邮件客户端；留空则只用「复制内容」
SUBMIT_EMAIL=

# 邮件订阅入口（可选）：SUBSCRIBE_URL 填 Tally/Buttondown 等表单地址；
# 或 SUBSCRIBE_EMAIL 填收件邮箱（mailto 订阅，人工加进 data/subscribers.txt）
SUBSCRIBE_URL=
SUBSCRIBE_EMAIL=

# 邮件摘要（可选；不配就跳过发信，站点照常生成）
# 以 Resend 为例：SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=re_xxx
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=AI 赛事雷达 <digest@your-domain.example>
# 也可以不设 DIGEST_TO，改在 data/subscribers.txt 里一行一个收件人
DIGEST_TO=
DIGEST_DAYS=2
# SKIP_DIGEST=1
